# Copy this file to ".env" (same folder as server.js) and fill in what you need.
# Never upload .env to GitHub: it holds your secret key. It is already in .gitignore.

# Port the shop listens on (on Render/Railway this is set for you).
PORT=4080

# The web address customers use, once the shop is hosted. Must start with https://
# Leave empty when running on your own computer.
PUBLIC_URL=

# Paystack secret key (Dashboard > Settings > API Keys & Webhooks).
# Start with the test key (sk_test_...). Switch to sk_live_... when you are ready for real money.
# Leave empty to keep confirming MoMo payments by hand.
PAYSTACK_SECRET_KEY=

# Where the database, photos and backups are kept. On Render use the disk path, e.g. /var/data
DATA_DIR=data

# How many daily backups to keep.
BACKUP_DAYS=14
